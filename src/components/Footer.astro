---
const groups = [
  {
    title: 'Belajar',
    links: [
      { href: '/materi', label: 'Materi' },
      { href: '/pajak-indonesia', label: 'Pajak di Indonesia' },
      { href: '/tutorial', label: 'Tutorial' },
    ],
  },
  {
    title: 'Latihan',
    links: [
      { href: '/kalkulator', label: 'Kalkulator Pajak' },
      { href: '/kuis', label: 'Kuis Interaktif' },
    ],
  },
];
---

<footer class="border-t border-line bg-paper-raised">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-2.5">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-emerald text-paper font-display text-base font-semibold">P</span>
          <span class="font-display text-lg font-semibold">Pajakademi</span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-soft">
          Platform edukasi pajak untuk masyarakat dan pelajar Indonesia — belajar
          istilah, aturan, dan kewajiban pajak lewat materi, kalkulator, dan kuis
          yang mudah dipahami.
        </p>
      </div>

      {groups.map((group) => (
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-ink-soft">{group.title}</h3>
          <ul class="mt-4 space-y-3">
            {group.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-ink hover:text-emerald-strong">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-line pt-6 text-xs text-ink-soft sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} Pajakademi. Konten edukatif, bukan nasihat pajak resmi.</p>
      <p>Dibuat untuk membantu masyarakat &amp; sekolah memahami pajak Indonesia.</p>
    </div>
  </div>
</footer>
