---
import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('tutorial');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allEntries = (await getCollection('tutorial')).sort((a, b) => a.data.urutan - b.data.urutan);
const currentIndex = allEntries.findIndex((e) => e.id === entry.id);
const next = allEntries[currentIndex + 1];
---

<Layout title={entry.data.title} description={entry.data.excerpt}>
  <article class="mx-auto max-w-3xl px-5 pb-24 pt-14 sm:px-8 sm:pt-20">
    <a href="/tutorial" class="text-sm font-semibold text-ink-soft hover:text-emerald-strong">← Semua tutorial</a>

    <div class="mt-6 flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-ink-soft">
      <span>{entry.data.langkah} langkah</span>
      <span aria-hidden="true">·</span>
      <span>{entry.data.durasi}</span>
    </div>

    <h1 class="font-display mt-4 text-3xl font-semibold leading-tight tracking-tight text-ink sm:text-4xl">
      {entry.data.title}
    </h1>

    <div class="prose-materi mt-10">
      <Content />
    </div>

    {next && (
      <div class="mt-16 rounded-2xl border border-line bg-paper-raised p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-ink-soft">Tutorial berikutnya</p>
        <a href={`/tutorial/${next.id}`} class="font-display mt-2 block text-xl font-semibold text-ink hover:text-emerald-strong">
          {next.data.title} →
        </a>
      </div>
    )}
  </article>
</Layout>
