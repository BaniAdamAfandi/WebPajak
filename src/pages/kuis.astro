---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Kuis Pajak" description="Uji pemahamanmu tentang pajak Indonesia lewat 10 soal pilihan ganda, lengkap dengan pembahasan tiap jawaban.">
  <section class="mx-auto max-w-3xl px-5 pb-24 pt-14 sm:px-8 sm:pt-20">
    <span class="text-xs font-semibold uppercase tracking-wide text-emerald-strong">Latihan</span>
    <h1 class="font-display mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Kuis Pajak Indonesia</h1>
    <p class="mt-5 text-lg text-ink-soft">
      10 soal pilihan ganda seputar istilah dan aturan pajak. Setiap jawaban
      langsung disertai pembahasan singkat.
    </p>

    <div id="quiz-root" class="mt-10 rounded-3xl border border-line bg-paper-raised p-6 sm:p-8"></div>
  </section>
</Layout>

<script>
  type Question = {
    q: string;
    options: string[];
    correct: number;
    explain: string;
  };

  const questions: Question[] = [
    {
      q: 'Apa kepanjangan dari PPh?',
      options: ['Pajak Penghasilan', 'Pajak Pertambahan Harga', 'Pajak Penjualan Harta', 'Pajak Pendapatan Harian'],
      correct: 0,
      explain: 'PPh adalah singkatan dari Pajak Penghasilan — dikenakan atas penghasilan yang diterima orang pribadi maupun badan.',
    },
    {
      q: 'Siapa yang memotong dan menyetorkan PPh 21 karyawan tetap?',
      options: ['Karyawan itu sendiri lewat SPT tahunan', 'Pemberi kerja / perusahaan', 'Bank tempat gaji ditransfer', 'Kantor pajak setempat'],
      correct: 1,
      explain: 'PPh 21 dipotong langsung oleh pemberi kerja dari gaji karyawan, lalu disetorkan dan dilaporkan ke DJP.',
    },
    {
      q: 'Berapa PTKP untuk status TK/0 (belum kawin, tanpa tanggungan)?',
      options: ['Rp36.000.000', 'Rp48.000.000', 'Rp54.000.000', 'Rp60.000.000'],
      correct: 2,
      explain: 'PTKP TK/0 sebesar Rp54.000.000/tahun, berlaku sejak 2016 berdasarkan PMK 101/PMK.010/2016.',
    },
    {
      q: 'Tarif PPh 21 lapisan pertama (Penghasilan Kena Pajak s.d. Rp60 juta) menurut UU HPP adalah...',
      options: ['5%', '10%', '15%', '20%'],
      correct: 0,
      explain: 'Lapisan pertama tarif progresif Pasal 17 (setelah UU HPP) adalah 5% untuk PKP sampai dengan Rp60.000.000.',
    },
    {
      q: 'PPN termasuk jenis pajak...',
      options: [
        'Langsung, dibayar sendiri oleh penerima penghasilan',
        'Tidak langsung, dipungut penjual dari konsumen',
        'Pajak daerah yang dikelola Pemda',
        'Pajak final khusus UMKM',
      ],
      correct: 1,
      explain: 'PPN adalah pajak tidak langsung: beban ada di konsumen, tapi kewajiban memungut & menyetor ada di penjual (PKP).',
    },
    {
      q: 'Berapa tarif PPN efektif untuk transaksi non-mewah sehari-hari sejak 2025?',
      options: ['10%', '11%', '12%', '13%'],
      correct: 1,
      explain: 'Meski tarif dasar 12%, mekanisme DPP nilai lain (11/12) membuat beban PPN barang/jasa non-mewah tetap setara 11%.',
    },
    {
      q: 'Skema PPh Final UMKM (PP 23/2018) mengenakan tarif berapa dari omzet?',
      options: ['0,5%', '1%', '2,5%', '5%'],
      correct: 0,
      explain: 'Skema final UMKM mengenakan tarif 0,5% dari omzet bulanan, jauh lebih sederhana daripada tarif progresif.',
    },
    {
      q: 'Lembaga yang mengelola PPh dan PPN adalah...',
      options: ['Direktorat Jenderal Pajak (DJP)', 'Direktorat Jenderal Bea dan Cukai', 'Badan Pendapatan Daerah', 'Otoritas Jasa Keuangan'],
      correct: 0,
      explain: 'DJP di bawah Kementerian Keuangan mengelola pajak pusat termasuk PPh dan PPN.',
    },
    {
      q: 'Batas waktu pelaporan SPT Tahunan untuk wajib pajak orang pribadi adalah...',
      options: ['31 Januari', '28 Februari', '31 Maret', '30 April'],
      correct: 2,
      explain: 'SPT Tahunan orang pribadi paling lambat dilaporkan 31 Maret tahun berikutnya (badan usaha: 30 April).',
    },
    {
      q: 'Barang tergolong "mewah" seperti mobil dan kapal pesiar dikenakan tarif PPN...',
      options: ['11%', '12%', '15%', '20%'],
      correct: 1,
      explain: 'Barang/jasa tergolong mewah dikenakan tarif PPN penuh 12%, berbeda dari barang non-mewah yang efektif 11%.',
    },
  ];

  let current = 0;
  let score = 0;
  let answered = false;
  const userAnswers: number[] = [];

  const root = document.getElementById('quiz-root')!;

  function optionClass(i: number, selected: number | null, correct: number) {
    if (selected === null) {
      return 'border-line hover:border-emerald hover:bg-paper';
    }
    if (i === correct) return 'border-emerald bg-emerald-tint text-emerald-strong';
    if (i === selected) return 'border-clay bg-clay-tint text-clay';
    return 'border-line opacity-60';
  }

  function renderQuestion() {
    const item = questions[current];
    const selected = answered ? userAnswers[current] : null;

    root.innerHTML = `
      <div class="mb-6 flex items-center justify-between text-xs font-semibold uppercase tracking-wide text-ink-soft">
        <span>Soal ${current + 1} / ${questions.length}</span>
        <span>Skor: ${score}</span>
      </div>
      <div class="mb-6 h-1.5 w-full overflow-hidden rounded-full bg-paper">
        <div class="h-full rounded-full bg-emerald transition-all" style="width: ${((current) / questions.length) * 100}%"></div>
      </div>
      <h2 class="font-display text-xl font-semibold leading-snug text-ink sm:text-2xl">${item.q}</h2>
      <div id="options" class="mt-6 space-y-3"></div>
      <div id="explain" class="mt-5 hidden rounded-xl bg-paper px-4 py-3 text-sm leading-relaxed text-ink-soft"></div>
      <div class="mt-6 flex justify-end">
        <button id="next-btn" class="hidden rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper">
          ${current === questions.length - 1 ? 'Lihat hasil' : 'Lanjut →'}
        </button>
      </div>
    `;

    const optionsEl = root.querySelector('#options')!;
    item.options.forEach((opt, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `w-full rounded-xl border px-4 py-3.5 text-left text-sm font-medium transition-colors ${optionClass(i, selected, item.correct)}`;
      btn.textContent = opt;
      btn.addEventListener('click', () => selectOption(i));
      optionsEl.appendChild(btn);
    });

    if (answered) {
      const explainEl = root.querySelector('#explain')!;
      explainEl.textContent = item.explain;
      explainEl.classList.remove('hidden');
      root.querySelector('#next-btn')!.classList.remove('hidden');
    }
  }

  function selectOption(i: number) {
    if (answered) return;
    answered = true;
    userAnswers[current] = i;
    if (i === questions[current].correct) score++;
    renderQuestion();
  }

  function next() {
    if (current === questions.length - 1) {
      renderResult();
      return;
    }
    current++;
    answered = false;
    renderQuestion();
  }

  function renderResult() {
    const pct = Math.round((score / questions.length) * 100);
    let msg = 'Terus belajar, coba baca materi dasar dulu ya.';
    if (pct >= 80) msg = 'Mantap! Pemahamanmu soal pajak sudah solid.';
    else if (pct >= 50) msg = 'Lumayan! Beberapa konsep masih perlu diperdalam.';

    root.innerHTML = `
      <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-wide text-ink-soft">Hasil Kuis</p>
        <p class="font-display mt-3 text-5xl font-semibold text-ink">${score}/${questions.length}</p>
        <p class="mt-2 text-ink-soft">${msg}</p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <button id="retry-btn" class="rounded-full bg-emerald px-6 py-3 text-sm font-semibold text-paper">Ulangi Kuis</button>
          <a href="/materi" class="rounded-full border border-line px-6 py-3 text-center text-sm font-semibold text-ink">Baca Materi Dulu</a>
        </div>
      </div>
    `;
    root.querySelector('#retry-btn')!.addEventListener('click', () => {
      current = 0;
      score = 0;
      answered = false;
      userAnswers.length = 0;
      renderQuestion();
    });
  }

  root.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).id === 'next-btn') next();
  });

  renderQuestion();
</script>
